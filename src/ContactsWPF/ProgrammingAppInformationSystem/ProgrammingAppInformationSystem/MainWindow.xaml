<Window x:Class="ProgrammingAppInformationSystem.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:uc="clr-namespace:View.Controls"
        xmlns:uc="clr-namespace:ProgrammingAppInformationSystem.Model."
        mc:Ignorable="d"
        Title="Contacts" Height="450" Width="800" Icon="Resources\contacts_96x96.ico">
    <Window.Resources>

        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>

        <Style TargetType="Button">
            <Setter Property="Height" Value="25"/>
            <Setter Property="Width" Value="75"/>
            <Setter Property="Margin" Value="3"/>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Margin" Value="3"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="3"/>
        </Style>
        <DataTemplate x:Key="contactTemplate">
            <DockPanel>
                <Image Source="/photo_placeholder_100x100.png" DockPanel.Dock="Left"
                       Width="40" Height="40"/>
                <StackPanel Margin="3">
                    <TextBlock Text="{Binding Name}" FontWeight="Bold"/>
                    <TextBlock Text="{Binding Phone}"/>
                </StackPanel>
            </DockPanel>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition MinWidth="300"/>
            <ColumnDefinition Width="auto"/>
            <ColumnDefinition MinWidth="300"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#f8f8f8"/>

        <Grid Grid.Column="0" Margin="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition/>
                <RowDefinition Height="auto"/>
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" LastChildFill="True">
                <TextBlock DockPanel.Dock="Left" Text="Find:"/>
                <TextBox/>
            </DockPanel>

            <ListBox Grid.Row="1" ItemsSource="{Binding Contacts}"
                     SelectedItem="{Binding SelectedContact}"
                     Margin="3" ItemTemplate="{StaticResource contactTemplate}"/>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Width="auto" Content="Add"
                        Command="{Binding AddCommand}" IsEnabled="{Binding ReadMode}"/>
                <Button Grid.Column="1" Width="auto" Content="Edit"
                        Command="{Binding EditCommand}" CommandParameter="{Binding SelectedContact}"
                        IsEnabled="{Binding ReadMode}"/>
                <Button Grid.Column="2" Width="auto" Content="Remove"
                        Command="{Binding RemoveCommand}" CommandParameter="{Binding SelectedContact}"
                        IsEnabled="{Binding ReadMode}"/>
            </Grid>
        </Grid>

        <GridSplitter Grid.Column="1" ShowsPreview="False" Width="3"
                      HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="#ffffff"/>

        <StackPanel Grid.Column="2">
            <uc:ContactControl/>
            <Button HorizontalAlignment="Left" Margin="111 50 0 0" Content="Apply"
                    Command="{Binding ApplyCommand}" CommandParameter="{Binding SelectedContact}"
                    Visibility="{Binding EditMode, Converter={StaticResource BoolToVisibilityConverter}}"/>
        </StackPanel>
    </Grid>
</Window>